@page "/viewers"

@using Microsoft.AspNetCore.SignalR.Client
@using Pin.LiveSports.Core.Models
@using Pin.LiveSports.Core.Services.Interfaces
@using Pin.LiveSports.Blazor.Hubs
@using Pin.LiveSports.Blazor.Components

@inject NavigationManager Navigation
@inject IGameService _gameService

@if (!IsJoined)
{   
    <JoinGameReport Viewer="viewer"
                    OnJoin="AddViewer"
                    OnStart="IsStarted"
                    ErrorMessage="@errorMessage">
    </JoinGameReport>
}
else
{
    <h2 style="text-align:center">@game.Name: wild water kajak</h2>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-5">
                <PlayersList Game="game">
                </PlayersList>
                @if (selectedPlayer != null)
                {
                    <div class="d-flex align-items-center">
                        <img src=@selectedPlayer.Image class="img-fluid" style="max-width: 350px; max-height: 350px;" alt="...">
                        <div>
                            <h5 class="m-3"> @selectedPlayer.FullName</h5>
                            <div class="d-flex m-3 align-items-center">
                                <img src="@selectedPlayer.CountryFlagIcon" class="img-fluid" style="max-width: 75px; max-height: 75px;" />
                                <h5 class="m-3">@selectedPlayer.Country</h5>
                            </div>
                            <div class="d-flex align-items-center m-3">
                                <label>Leeftijd: </label>
                                <h5 class="m-3">@selectedPlayer.Age</h5>
                            </div>

                        </div>
                    </div>
                }
            </div>
            <div class="col-md-5" style="border: double; height: 650px; background-color: powderblue; overflow: auto;">
                <ReportOverview Reports="reports"></ReportOverview>
            </div>
            <div class="col-md-2">
                <img src="images/parcour.png" style="height:500px" />
                <ViewersList Viewers="viewers" Feedback="@Feedback"></ViewersList>
            </div>
        </div>
    </div>
}

@code {
    public string Feedback { get; set; }
    private Viewer viewer { get; set; } = new Viewer();
    public bool IsJoined { get; set; } = false;
    public bool IsStarted { get; set; } = false;
    private string errorMessage;

    private HubConnection? hubConnection;
    private List<Viewer> viewers = new List<Viewer>();
    private Player selectedPlayer;
    private List<Report> reports = new List<Report>();
    private Game game;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .Build();

        hubConnection.On<string>("NewViewerAddedToViewerList", async (viewerName) =>
        {
            Feedback = $"New viewer {viewerName} joined";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            Feedback = string.Empty;
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On("ReportStarted", async () =>
        {
            IsStarted = game.IsStarted;
            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Report>("ReceiveMessage", async (report) =>
        {
            game = _gameService.GetGame();
            game.Players = game.Players.OrderBy(p => p.BestTime.ToString(@"mm\:ss")).ToList();
            selectedPlayer = game.SelectedPlayer;
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();

        game = _gameService.GetGame();
        IsStarted = game.IsStarted;
        reports = game.Reports;
        if (selectedPlayer == null)
        {
            selectedPlayer = game.SelectedPlayer;
        }
    }

    private async Task AddViewer()
    {
        if (!string.IsNullOrWhiteSpace(viewer.Name))
        {
            IsJoined = true;
            await NotifyNewViewerJoined();
            viewers = _gameService.GetAllViewers();
        }
        else
        {
            errorMessage = "Gelieve een naam in te geven";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            errorMessage = string.Empty;
        }

    }

    private async Task NotifyNewViewerJoined()
    {
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync(nameof(GameHub.NewViewerJoined), viewer.Name);
        }
    }
}
