@page "/reporters"

@using Pin.LiveSports.Core.Models
@using Pin.LiveSports.Core.Services.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.LiveSports.Blazor.Components
@using Pin.LiveSports.Blazor.Hubs

@inject NavigationManager Navigation
@inject IGameService _gameService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <button class="btn btn-primary" @onclick="StartGame">Start verslag</button>
            @if (game.IsStarted)
            {
                <PlayersList IsReporter="true"
                             Game="game"
                             SetPlayer="(e) => SetSelectedPlayer(e)"
                             SetRound="(e) => SetSelectedRound(e)"
                             RoundIsSelected="roundIsSelected">
                </PlayersList>
                <div>
                    @errorMessage
                </div>
                <button class="btn btn-primary" @onclick="StartRound">Start Ronde</button>
                <button class="btn btn-danger" @onclick="StopRound">Stop Ronde</button>

                @if (ReportHasStarted)
                {


                    <div class="mt-2">
                        @if (!raceHasStarted)
                        {
                            <button class="btn btn-info" @onclick="StartPlayerRound">Start race</button>
                        }
                        else
                        {
                            <button class="btn btn-info" @onclick="SetMessage">Verstuur bericht</button>
                            <button class="btn btn-danger" @onclick="SetCrash">Crash</button>
                            <button class="btn btn-danger" @onclick="SetPenalty">Straftijd</button>
                            <button class="btn btn-primary" @onclick="SetEndPlayerRound">Einde race</button>
                        }
                    </div>

                    @if (isPenalty)
                    {
                        <PenaltyForm Report="report"
                                     Game="game"
                                     OnSendPenalty="SendGameStats">
                        </PenaltyForm>
                    }

                    if (isMessage)
                    {
                        <MessageForm Report="report"
                                     OnSend="SendGameStats">
                        </MessageForm>

                        <EditForm Model="report" OnValidSubmit="SendGameStats">
                            <InputText @bind-Value="report.Message" class="form-control mb-2" placeholder="Enter report message" />
                            <button class="btn btn-primary" type="submit">Einde ronde</button>
                            <button class="btn btn-primary" type="submit">Spell stilgelegd door obstakel</button>
                        </EditForm>
                    }
                    if (isCrash)
                    {
                        <CrashForm Report="report"
                                   OnSend="SendGameStats">
                        </CrashForm>
                    }
                }
            }
        </div>
        <div class="col-md-5" style="border:double; height:500px">
            <ReportOverview Reports="reports"></ReportOverview>
        </div>
        <div class="col-md-2">
            <img src="images/parcour.png" style="height:500px" />
            <ViewersList Viewers="viewers" Feedback="@Feedback"></ViewersList>
        </div>
    </div>
</div>

@code {
    public string Feedback { get; set; }

    private List<Viewer> viewers = new List<Viewer>();
    private HubConnection? hubConnection;
    private Report report = new Report();
    private List<Report> reports = new List<Report>();

    private string roundNumber;
    private Game game = new Game();
    private bool ReportHasStarted;
    private string errorMessage;
    private bool isPenalty;
    private bool isMessage;
    private bool isCrash;
    private bool roundIsSelected;
    private bool raceHasStarted;
    private bool isRunning = false;
    private Timer timer;
    private TimeSpan timeSpan;
    private DateTime startTime;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .Build();

        hubConnection.On<string>("NewViewerAddedToViewerList", async (viewerName) =>
        {
            Feedback = $"New viewer {viewerName} joined";
            LoadViewers();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            Feedback = string.Empty;
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        game = _gameService.GetGame();
        reports = game.Reports;
        ReportHasStarted = game.IsStarted;
    }

    private void LoadViewers()
    {
        viewers = _gameService.GetAllViewers();
    }

    private async Task StartGame()
    {
        if (hubConnection is not null)
        {
            game.IsStarted = true;
            await hubConnection.SendAsync(nameof(GameHub.StartReport));
        }
    }

    private void StopRound()
    {
        roundIsSelected = false;
        game.SelectedPlayer = null;
        ReportHasStarted = false;
    }

    private void StartPlayerRound()
    {
        raceHasStarted = true;
        StartTimer();
    }

    private async void StopPlayerRound()
    {
        raceHasStarted = false;
        if (hubConnection is not null)
        {
            StopTimer();
            ReportHasStarted = true;
            game.SelectedPlayer.GameRounds.FirstOrDefault(r => r.RoundNumber == game.RoundNumber).RoundTime = timeSpan;

            report.Message = $"Einde rond {game.RoundNumber} voor {game.SelectedPlayer.FullName} met een tijd van {game.SelectedPlayer.GameRounds.FirstOrDefault(r => r.RoundNumber == game.RoundNumber).RoundTime.ToString(@"mm\:ss")}";
            report.Image = "images/stoprace.png";
            _gameService.AddReport(report);
            await hubConnection.SendAsync(nameof(GameHub.SendReport), report);
        }
        report = new Report();
    }

    private async Task StartRound()
    {
        if (game.SelectedPlayer == null || string.IsNullOrWhiteSpace(game.RoundNumber))
        {
            errorMessage = "Gelieve een speler en ronde te selecteren";
            LoadViewers();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            errorMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            if (hubConnection is not null)
            {
                ReportHasStarted = true;

                report.Message = $"Start ronde {game.RoundNumber}: {game.SelectedPlayer.FullName}";
                report.Image = "images/startrace.png";
                _gameService.AddReport(report);
                await hubConnection.SendAsync(nameof(GameHub.SendReport), report);
            }
            report = new Report();
        }
    }

    private async Task SendGameStats()
    {
        if (hubConnection is not null)
        {
            _gameService.AddReport(report);
            await hubConnection.SendAsync(nameof(GameHub.SendReport), report);
        }
        report = new Report();
    }

    private void SetPenalty()
    {
        isCrash = false;
        isMessage = false;
        isPenalty = !isPenalty;
    }

    private void SetMessage()
    {
        isCrash = false;
        isPenalty = false;
        isMessage = !isMessage;
    }

    private void SetCrash()
    {
        isPenalty = false;
        isMessage = false;
        isCrash = !isCrash;
    }

    private void SetEndPlayerRound()
    {
        isCrash = false;
        isMessage = false;
        isPenalty = false;
        StopPlayerRound();
    }

    private void SetSelectedPlayer(ChangeEventArgs e)
    {
        var player = game.Players.FirstOrDefault(p => p.FullName == e.Value.ToString());
        player.GameRounds = new List<GameRound>();

        if (!player.GameRounds.Any(r => r.RoundNumber == game.RoundNumber))
        {
            player.GameRounds.Add(new GameRound { RoundNumber = game.RoundNumber, PenaltyTime = new TimeSpan() });
        }

        game.SelectedPlayer = player;
    }

    private void SetSelectedRound(ChangeEventArgs e)
    {
        game.RoundNumber = e.Value.ToString();
        roundIsSelected = true;
    }

    private void StartTimer()
    {
        if (!isRunning)
        {
            startTime = DateTime.Now;
            timer = new Timer(UpdateTime, null, 0, 1000);
            isRunning = true;
        }
    }

    private void StopTimer()
    {
        if (isRunning)
        {
            timer?.Dispose();
            isRunning = false;
        }
    }

    private void UpdateTime(object state)
    {
        timeSpan = DateTime.Now - startTime;
        InvokeAsync(StateHasChanged);
    }
}
