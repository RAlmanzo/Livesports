@page "/reporters"

@using Pin.LiveSports.Core.Models
@using Pin.LiveSports.Core.Services.Interfaces
@using Microsoft.AspNetCore.SignalR.Client
@using Pin.LiveSports.Blazor.Components
@using Pin.LiveSports.Blazor.Hubs

@inject NavigationManager Navigation
@inject IGameService _gameService

<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <button class="btn btn-primary" @onclick="StartGame">Start verslag</button>
            <PlayersList IsReporter="true"
                         SetPlayer="(e) => SetSelectedPlayer(e)"
                         SetRound="(e) => SetSelectedRound(e)">
            </PlayersList>
            <div>
                @errorMessage
            </div>
            <EditForm Model="report" OnValidSubmit="StartReport">
                <button class="btn btn-primary" type="submit">Start Ronde</button>
            </EditForm>
            @if (ReportHasStarted)
            {

                <button class="btn btn-danger" @onclick="SetPenalty">Straftijd</button>

                @if (IsPenalty)
                {
                    <PenaltyForm Report="report"
                                 OnSendPenalty=SendPortPenalty>
                    </PenaltyForm>
                }

                <EditForm Model="report" OnValidSubmit="SendGameStats">
                    <InputText @bind-Value="report.Message" class="form-control mb-2" placeholder="Enter report message" />
                    <button class="btn btn-primary" type="submit">Vis</button>
                    <button class="btn btn-primary" type="submit">Crash</button>
                    <button class="btn btn-primary" type="submit">Gezonken</button>
                    <button class="btn btn-primary" type="submit">Gewond</button>
                    <button class="btn btn-primary" type="submit">Einde</button>
                    <button class="btn btn-primary" type="submit">Spell stilgelegd door obstakel</button>
                </EditForm>
            }
        </div>
        <div class="col-md-5" style="border:double; height:500px">
            <ReportOverview Reports="reports"></ReportOverview>
        </div>
        <div class="col-md-2">
            <img src="images/parcour.png" style="height:500px" />
            <ViewersList Viewers="viewers" Feedback="@Feedback"></ViewersList>
        </div>
    </div>
</div>

@code {
    public string Feedback { get; set; }

    private List<Viewer> viewers = new List<Viewer>();
    private HubConnection? hubConnection;
    private Report report = new Report();
    private List<Report> reports = new List<Report>();

    private string roundNumber;
    private Game game = new Game();
    private bool ReportHasStarted;
    private string errorMessage;
    private bool IsPenalty;

    protected override async Task OnInitializedAsync()
    {
        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .Build();

        hubConnection.On<string>("NewViewerAddedToViewerList", async (viewerName) =>
        {
            Feedback = $"New viewer {viewerName} joined";
            LoadViewers();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            Feedback = string.Empty;
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
        game = _gameService.GetGame();
    }

    private void LoadViewers()
    {
        viewers = _gameService.GetAllViewers();
    }

    private async Task StartGame()
    {
        if (hubConnection is not null)
        {
            game.IsStarted = true;
            await hubConnection.SendAsync(nameof(GameHub.StartReport));
        }
    }

    private async Task StartReport()
    {
        if (game.SelectedPlayer == null)
        {
            errorMessage = "Gelieve een speler en ronde te selecteren";
            LoadViewers();
            await InvokeAsync(StateHasChanged);
            await Task.Delay(3000);
            errorMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            if (hubConnection is not null)
            {
                ReportHasStarted = true;
                report.Message = $"Start ronde {game.RoundNumber}: {game.SelectedPlayer.FullName}";
                reports.Add(report);
                await hubConnection.SendAsync(nameof(GameHub.SendReport), report);
            }
            report = new Report();
        }
    }

    private async Task SendGameStats()
    {
        if (hubConnection is not null)
        {
            reports.Add(report);
            await hubConnection.SendAsync(nameof(GameHub.SendReport), report);
        }
        report = new Report();
    }

    private async void SendPortPenalty(int penaltyType)
    {
        switch (penaltyType)
        {
            case 1:
                report.PenaltyIcon = "images/pen2green.gif";
                await SendGameStats();
                break;
            case 2:
                report.PenaltyIcon = "images/pen2red.gif";
                await SendGameStats();
                break;
            case 3:
                report.PenaltyIcon = "images/pen50green.gif";
                await SendGameStats();
                break;
            case 4:
                report.PenaltyIcon = "images/pen50red.gif";
                await SendGameStats();
                break;
            default:
                Console.WriteLine("Unknown penalty");
                break;
        }
    }

    private void SetPenalty()
    {
        IsPenalty = !IsPenalty;
    }

    private void SetSelectedPlayer(ChangeEventArgs e)
    {
        game.SelectedPlayer = game.Players.FirstOrDefault(p => p.FullName == e.Value.ToString());
    }

    private void SetSelectedRound(ChangeEventArgs e)
    {
        game.RoundNumber = e.Value.ToString();
    }
}
