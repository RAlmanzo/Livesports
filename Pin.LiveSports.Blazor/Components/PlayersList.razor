@using Pin.LiveSports.Core.Services.Interfaces
@using Pin.LiveSports.Core.Models

@inject IGameService _gameService

<h3>Spelers</h3>

<table class="table" style="border:double">
    <thead>
        <tr>
            <th>Positie</th>
            <th>Land</th>
            <th>Naam</th>
            <th>Straftijd</th>
            <th>Tijd</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in _players)
        {
            <tr>
                <td>@player.Position</td>
                <td>
                    @player.Country
                </td>
                <td>@player.FullName</td>
                <td></td>
                <td></td>
            </tr>
        }
    </tbody>
</table>

@if (IsReporter)
{
    <div>
        <select @onchange="e => SetPlayer.InvokeAsync(e)">
            <option value="">Selecteer speler</option>
            @foreach (var player in _players)
            {
                <option value="@player.FullName">@player.FullName</option>
            }
        </select>

        <select>
            <option value="">Selecteer ronde</option>
            @foreach (var player in _players)
            {
                <option value="@player.FullName">@player.FullName</option>
            }
        </select>
    </div>
}



@code {
    private List<Player> _players = new List<Player>();

    [Parameter]
    public bool IsReporter { get; set; } = false;
    [Parameter]
    public EventCallback<ChangeEventArgs> SetPlayer { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _players = _gameService.GetAllPlayers();
        await InvokeAsync(StateHasChanged);
    }
}
