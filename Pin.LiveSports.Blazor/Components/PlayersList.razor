@using Pin.LiveSports.Core.Services.Interfaces
@using Pin.LiveSports.Core.Models

@inject IGameService _gameService

<h3>Spelers</h3>

<table class="table" style="border:double">
    <thead>
        <tr>
            <th>Positie</th>
            <th>Land</th>
            <th>Naam</th>
            <th>Straftijd</th>
            <th>Tijd</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in _players)
        {
            <tr>
                <td>@player.Position</td>
                <td>
                    <img src=@player.CountryFlagIcon class="img-fluid" style="max-width: 50px; max-height: 50px;" /> @player.Country
                </td>
                <td>@player.FullName</td>
                @if (player.GameRounds != null)
                {
                    <td>@player.GameRounds.FirstOrDefault(r => r.RoundNumber == Game.RoundNumber).PenaltyTime.ToString(@"mm\:ss")</td>
                }
                else
                {
                    <td>@defaultTime</td>
                }
                @if (player.GameRounds != null)
                {
                    <td>@player.GameRounds.FirstOrDefault(r => r.RoundNumber == Game.RoundNumber).RoundTime.ToString(@"mm\:ss")</td>
                }
                else
                {
                    <td>@defaultTime</td>
                }
            </tr>
        }
    </tbody>
</table>

@if (IsReporter)
{
    <div>
        <select @onchange="e => SetRound.InvokeAsync(e)">
            <option value="">Selecteer ronde</option>
            @for (int i = 1; i < 3; i++)
            {
                <option value="@i">ronde: @i</option>
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(Game.RoundNumber))
        {
            <select @onchange="e => SetPlayer.InvokeAsync(e)">
                <option value="">Selecteer speler</option>
                @foreach (var player in _players)
                {
                    <option value="@player.FullName">@player.FullName</option>
                }
            </select>
        }
    </div>

    @*<div class="mt-2">
        <button class="btn btn-danger" @onclick="StartTimer">StartTimer</button>
        <button class="btn btn-danger" @onclick="StopTimer">StopTimer</button>
    </div>*@
}

@code {
    private List<Player> _players = new List<Player>();
    private TimeSpan defaultTime = new TimeSpan();
    private bool isRunning = false;
    private Timer timer;
    private TimeSpan timeSpan;
    private DateTime startTime;

    [Parameter]
    public bool IsReporter { get; set; } = false;
    [Parameter]
    public EventCallback<ChangeEventArgs> SetPlayer { get; set; }
    [Parameter]
    public EventCallback<ChangeEventArgs> SetRound { get; set; }
    [Parameter]
    public Game Game { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Game = _gameService.GetGame();
        _players = Game.Players;
        await InvokeAsync(StateHasChanged);
    }

    private void StartTimer()
    {
        if (!isRunning)
        {
            startTime = DateTime.Now;
            timer = new Timer(UpdateTime, null, 0, 1000);
            isRunning = true;
        }
    }

    private void StopTimer()
    {
        if (isRunning)
        {
            timer?.Dispose();
            isRunning = false;
        }
    }

    private void UpdateTime(object state)
    {
        timeSpan = DateTime.Now - startTime;
        InvokeAsync(StateHasChanged);
    }
}
