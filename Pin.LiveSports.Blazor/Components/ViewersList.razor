@using Pin.LiveSports.Core.Models

<div>
    @Feedback
</div>

<h2 style="font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif">Kijkers</h2>

<div class="viewersList">
    <ul>
        @foreach (var viewer in Viewers)
        {
            <li>@viewer.Name</li>
        }
    </ul>
</div>

@code {
    [Parameter]
    public List<Viewer> Viewers { get; set; }

    [Parameter]
    public string Feedback { get; set; }
}
