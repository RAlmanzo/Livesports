@using Pin.LiveSports.Core.Models

<label>@errorMessage</label>
<div class="d-flex align-items-center mt-3">
    <div class="m-3">
        <EditForm Model="Report" OnValidSubmit="() =>SetPenaltyMessage(1)">
            <label>Poortnummer</label>
            <InputNumber @bind-Value="portNumber" style="width: 45px;"></InputNumber>
            <button class="btn btn-success" type="submit">+2'</button>
        </EditForm>
    </div>
    <div>
        <EditForm Model="Report" OnValidSubmit="() =>SetPenaltyMessage(2)">
            <button class="btn btn-danger" type="submit">+2'</button>
        </EditForm>
    </div>
</div>
<div class="d-flex align-items-center mt-1">
    <div class="m-1">
        <EditForm Model="Report" OnValidSubmit="() =>SetPenaltyMessage(3)">   
            <div class="d-flex">
                <InputText @bind-Value="message" class="form-control mb-2" placeholder="Enter report message" />
                <button class="btn btn-success" type="submit">+50'</button>
            </div>
        </EditForm>    
    </div>
    <div>
        <EditForm Model="Report" OnValidSubmit="() =>SetPenaltyMessage(4)">
                <button class="btn btn-danger" type="submit">+50'</button>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Report Report { get; set; }
    [Parameter]
    public EventCallback<int> OnSendPenalty { get; set; }

    private int portNumber;
    private string message;
    private string errorMessage;

    private async void SetPenaltyMessage(int penaltyType)
    {
        if(portNumber < 1 || portNumber > 22)
        {          
            errorMessage = "Gelieve een poort tussen 1 tem 22 te kiezen!";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(1000);
            errorMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Report.PortNumber = portNumber;
            portNumber = 0;

            if (string.IsNullOrWhiteSpace(message))
            {
                if (penaltyType == 1 || penaltyType == 2)
                {
                    Report.Message = $"Poort: {Report.PortNumber} werd geraakt";
                    SendReport(penaltyType);
                }
                else
                {
                    portNumber = Report.PortNumber;

                    errorMessage = "Gelieve commentaar in te vullen";
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000);
                    errorMessage = string.Empty;
                    await InvokeAsync(StateHasChanged);
                }
            }
            else
            {
                Report.Message = $"Fout op poort {Report.PortNumber}: {message}";
                SendReport(penaltyType);
            }
            message = null;
        }
    }

    private async void SendReport(int penaltyType)
    {
        switch (penaltyType)
        {
            case 1:
                Report.PenaltyIcon = "images/pen2green.gif";
                await OnSendPenalty.InvokeAsync();
                break;
            case 2:
                Report.PenaltyIcon = "images/pen2red.gif";
                await OnSendPenalty.InvokeAsync();
                break;
            case 3:
                Report.PenaltyIcon = "images/pen50green.gif";
                await OnSendPenalty.InvokeAsync();
                break;
            case 4:
                Report.PenaltyIcon = "images/pen50red.gif";
                await OnSendPenalty.InvokeAsync();
                break;
            default:
                Console.WriteLine("Unknown penalty");
                break;
        }
    }
}
