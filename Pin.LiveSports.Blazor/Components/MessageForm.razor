@using Pin.LiveSports.Core.Models

@inject IWebHostEnvironment _webHost

<EditForm Model="Report" OnValidSubmit="e => OnSend.InvokeAsync()">
    <div class="mb-3">
        <label id="label" for="ImagePath" class="form-label">Image</label>
        <InputFile id="ImagePath" class="form-control" OnChange="LoadFile" @bind-Value="Report.Image" />
    </div>
    <InputText @bind-Value="Report.Message" class="form-control mb-2" placeholder="Enter report message" />
    <button class="btn btn-primary" type="submit">Verstuur</button>
</EditForm>

@code {
    [Parameter]
    public Report Report { get; set; }
    [Parameter]
    public EventCallback OnSend { get; set; }

    private IBrowserFile selectedFile;

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;

        if (selectedFile != null)
        {
            var fileName = $"{Guid.NewGuid()}{Path.GetExtension(selectedFile.Name)}";

            var pathToFolder = Path.Combine(_webHost.WebRootPath, "images");
            var pathToFile = Path.Combine(pathToFolder, fileName);

            Report.Image = $"/images/{fileName}";

            Directory.CreateDirectory(Path.GetDirectoryName(pathToFolder));

            using (var fileStream = new FileStream(pathToFile, FileMode.Create))
            {
                await selectedFile.OpenReadStream().CopyToAsync(fileStream);
            }
        }

        selectedFile = null;
    }
}
